# Ambiente de Execução (development ou production)
ENVIRONMENT=production

# Chave Secreta para Assinatura de Tokens JWT (Gere uma chave segura e aleatória de 32+ caracteres)
SECRET_KEY=substitua_por_uma_chave_secreta_forte_e_aleatoria_com_mais_de_32_caracteres

# Banco de Dados (SQLite local ou PostgreSQL em nuvem)
DATABASE_URL=sqlite:///./finance.db
# Para PostgreSQL: postgresql://usuario:senha@host:5432/finance_db

# Origens permitidas para requisições CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://seu-dominio.onrender.com

# Tempo de Expiração do Token JWT em minutos (7 dias = 10080)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
